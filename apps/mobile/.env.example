# ─── API Connection ──────────────────────────────────────────────────────────
# For local dev: use your computer's IP (not localhost), e.g. http://192.168.1.100:3000/api
# For production: use your Vercel API URL, e.g. https://api.moment.network/api
EXPO_PUBLIC_API_URL="http://localhost:3000/api"

# ─── Privy (same App ID used in apps/api/.env.local) ────────────────────────
# Get from: https://dashboard.privy.io > Settings > App ID
EXPO_PUBLIC_PRIVY_APP_ID=""

# ─── Solana ──────────────────────────────────────────────────────────────────
# For devnet: https://api.devnet.solana.com (free, no key needed)
# For mainnet via Helius: https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
EXPO_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"

# "devnet" for testing, "mainnet-beta" for production
EXPO_PUBLIC_SOLANA_NETWORK="devnet"

# ─── Base (Ethereum L2) ────────────────────────────────────────────────────
EXPO_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
EXPO_PUBLIC_BASE_CHAIN_ID=8453
EXPO_PUBLIC_BASE_NETWORK=mainnet
