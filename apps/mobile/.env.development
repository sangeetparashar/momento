# =============================================================================
# ⚠️  SECRET ROTATION NOTE — EXPO_PUBLIC_SOLANA_RPC_URL embeds the Helius API key
#     and ships in the client bundle. Rotate HELIUS_API_KEY; prefer a key-less
#     RPC proxy or an EAS secret. Other EXPO_PUBLIC_* values are public by design.
#     Values LEFT AS-IS for now (2026-06). See docs/solana-migration/SECRETS_REMEDIATION.md
# =============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# Momento Mobile — LOCAL DEVELOPMENT
# ──────────────────────────────────────────────────────────────────────────────

# ─── API Connection ──────────────────────────────────────────────────────────
# For local API testing: use your Mac's LAN IP (run: ipconfig getifaddr en0)
# e.g. EXPO_PUBLIC_API_URL="http://192.168.2.89:3000/api"
EXPO_PUBLIC_API_URL="https://momento-api-ten.vercel.app/api"

# ─── Privy ───────────────────────────────────────────────────────────────────
EXPO_PUBLIC_PRIVY_APP_ID="cmjbzyj4q00twlb0d1uc5w0sb"

# ─── Solana ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=b04d4e94-cc50-4905-a43d-909652645bd2"
EXPO_PUBLIC_SOLANA_NETWORK="mainnet-beta"
