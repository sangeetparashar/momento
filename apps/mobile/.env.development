# ──────────────────────────────────────────────────────────────────────────────
# Momento Mobile — LOCAL DEVELOPMENT
# ──────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in values. .env is gitignored.
# For physical device testing, use your LAN IP (run: ipconfig getifaddr en0)
# For Android emulator, use http://10.0.2.2:3000/api
# ──────────────────────────────────────────────────────────────────────────────

# ─── API Connection ──────────────────────────────────────────────────────────
# Mac LAN IP for physical device: http://<YOUR_IP>:3000/api
# Android emulator:               http://10.0.2.2:3000/api
# iOS simulator:                  http://localhost:3000/api
EXPO_PUBLIC_API_URL="http://localhost:3000/api"

# ─── Privy ───────────────────────────────────────────────────────────────────
# MUST match NEXT_PUBLIC_PRIVY_APP_ID in apps/api/.env.local
EXPO_PUBLIC_PRIVY_APP_ID=""

# ─── Solana ──────────────────────────────────────────────────────────────────
# Devnet: free, no API key needed
# Mainnet via Helius: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
EXPO_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"
EXPO_PUBLIC_SOLANA_NETWORK="devnet"
