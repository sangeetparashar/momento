# ──────────────────────────────────────────────────────────────────────────────
# Momento Mobile — PRODUCTION
# ──────────────────────────────────────────────────────────────────────────────
# Set via EAS Build secrets or eas.json env overrides.
# This file documents required variables.
# ──────────────────────────────────────────────────────────────────────────────

# ─── API Connection ──────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL="https://api.momento.network/api"

# ─── Privy ───────────────────────────────────────────────────────────────────
EXPO_PUBLIC_PRIVY_APP_ID=""

# ─── Solana (mainnet for production) ─────────────────────────────────────────
EXPO_PUBLIC_SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY"
EXPO_PUBLIC_SOLANA_NETWORK="mainnet-beta"

# ─── Base (Ethereum L2 — mainnet for production) ───────────────────────────
EXPO_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
EXPO_PUBLIC_BASE_CHAIN_ID=8453
EXPO_PUBLIC_BASE_NETWORK=mainnet
