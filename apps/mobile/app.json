{
  "expo": {
    "name": "Momento",
    "slug": "momento",
    "owner": "sangeetparashar24",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "momento",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#000000",
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Momento needs your location to show nearby creators and posts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Momento needs access to your photos to create posts."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00FF88"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-video",
      "./plugins/with-ios-script-sandboxing"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.momento.network",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Momento needs your location to show nearby creators and posts.",
        "NSPhotoLibraryUsageDescription": "Momento needs access to your photos to create posts.",
        "NSCameraUsageDescription": "Momento needs camera access to take photos for posts.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": "1.0.0"
    },
    "android": {
      "package": "com.momento.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a287df3-a2fd-4fdc-8e55-33fbfad22608"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/9a287df3-a2fd-4fdc-8e55-33fbfad22608"
    }
  }
}
