{
  "expo": {
    "name": "Momento",
    "slug": "momento",
    "owner": "sangeetparashar24",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "momento",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0D0D0D",
      "image": "./assets/icon.png",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0D0D",
          "image": "./assets/icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Momento needs your location to show nearby creators and posts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Momento needs access to your photos to create posts."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00FF88"
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.momento.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Momento needs your location to show nearby creators and posts."
      }
    },
    "android": {
      "package": "com.momento.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a287df3-a2fd-4fdc-8e55-33fbfad22608"
      }
    }
  }
}
