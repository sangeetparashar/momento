{
  "expo": {
    "name": "Momento",
    "slug": "momento",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "momento",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-location",
        { "locationAlwaysAndWhenInUsePermission": "Momento needs your location to show nearby creators and posts." }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "Momento needs access to your photos to create posts." }
      ],
      [
        "expo-notifications",
        { "icon": "./assets/notification-icon.png", "color": "#00FF88" }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.momento.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Momento needs your location to show nearby creators and posts."
      }
    },
    "android": {
      "package": "com.momento.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    }
  }
}
