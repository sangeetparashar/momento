{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3001",
        "EXPO_PUBLIC_PRIVY_APP_ID": "dev-privy-app-id",
        "EXPO_PUBLIC_SOLANA_RPC_URL": "https://api.devnet.solana.com",
        "EXPO_PUBLIC_SOLANA_NETWORK": "devnet"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging-api.momento.app",
        "EXPO_PUBLIC_PRIVY_APP_ID": "staging-privy-app-id",
        "EXPO_PUBLIC_SOLANA_RPC_URL": "https://api.devnet.solana.com",
        "EXPO_PUBLIC_SOLANA_NETWORK": "devnet"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.momento.app",
        "EXPO_PUBLIC_PRIVY_APP_ID": "prod-privy-app-id",
        "EXPO_PUBLIC_SOLANA_RPC_URL": "https://api.mainnet-beta.solana.com",
        "EXPO_PUBLIC_SOLANA_NETWORK": "mainnet-beta"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "developer@momento.app",
        "ascAppId": "PLACEHOLDER",
        "appleTeamId": "PLACEHOLDER"
      },
      "android": {
        "serviceAccountKeyPath": "./google-services.json",
        "track": "internal"
      }
    }
  }
}
