# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Get from: Supabase > Settings > Database > Connection string
# Transaction mode (port 6543) — used by Prisma for all queries
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
# Session/Direct mode (port 5432) — used by Prisma for migrations only
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ─── Privy Authentication ────────────────────────────────────────────────────
# Get from: https://dashboard.privy.io > Settings
# IMPORTANT: NEXT_PUBLIC_PRIVY_APP_ID must match EXPO_PUBLIC_PRIVY_APP_ID in apps/mobile/.env
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# ─── Upstash Redis ───────────────────────────────────────────────────────────
# Get from: https://console.upstash.com > Your database > REST API tab
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Supabase Storage ────────────────────────────────────────────────────────
# Get from: Supabase > Settings > API
# Project URL (NOT the database URL)
NEXT_PUBLIC_SUPABASE_URL=""
# Service role key (secret — has full admin access, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Helius (Solana RPC) ─────────────────────────────────────────────────────
# Get from: https://dev.helius.xyz > Dashboard > API Keys
HELIUS_API_KEY=""

# ─── Veriff (KYC) ────────────────────────────────────────────────────────────
# Get from: https://station.veriff.com > Integrations > API Keys
# Not needed if SKIP_KYC=true (recommended for development)
VERIFF_API_KEY=""
VERIFF_SHARED_SECRET=""

# ─── Fiat Onramp (Transak) ──────────────────────────────────────────────────
# Get from: https://dashboard.transak.com > API Keys
# Leave empty to use Transak's test/staging key
TRANSAK_API_KEY=""
# "STAGING" for testing, "PRODUCTION" for live
TRANSAK_ENVIRONMENT="STAGING"

# ─── Fiat Onramp (Stripe Crypto) ────────────────────────────────────────────
# Get from: https://dashboard.stripe.com > API Keys (requires crypto onramp approval)
# When set, creates full sessions with wallet pre-fill. Without it, uses hosted redirect.
# STRIPE_CRYPTO_SECRET_KEY=""

# ─── App Config ──────────────────────────────────────────────────────────────
# Local dev: http://localhost:3000 | Production: https://api.moment.network
NEXT_PUBLIC_API_URL="http://localhost:3000"
# Set to "true" to bypass KYC verification for creator applications (dev only)
SKIP_KYC="true"
