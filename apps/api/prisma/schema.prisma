generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  CREATOR
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum PostType {
  TEXT
  IMAGE
  VIDEO
}

model User {
  id              String    @id @default(uuid())
  privyUserId     String    @unique
  walletAddress     String    @unique
  primaryChain      String    @default("solana")
  email             String?
  username        String?   @unique
  displayName     String?
  bio             String?
  avatarUrl       String?
  bannerUrl       String?
  role            UserRole  @default(USER)
  kycStatus       KycStatus @default(NONE)
  isAdminApproved Boolean   @default(false)
  isAdmin         Boolean   @default(false)
  tokenSymbol     String?
  socialLinks     Json?
  locationLat     Float?
  locationLng     Float?
  pushToken       String?
  followerCount   Int       @default(0)
  followingCount  Int       @default(0)
  postCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  posts      Post[]
  likes      Like[]
  comments   Comment[]
  followers  Follow[]    @relation("following")
  following  Follow[]    @relation("follower")
  kycRecords KycRecord[]
  savedPosts SavedPost[]
  creatorTokens CreatorToken[]

  @@index([role])
  @@index([locationLat, locationLng])
  @@map("users")
}

model Post {
  id          String   @id @default(uuid())
  creatorId   String
  postType    PostType @default(TEXT)
  content     String?
  caption     String?
  mediaUrl    String?
  mediaUrls   Json?
  latitude    Float
  longitude   Float
  likeCount   Int      @default(0)
  commentCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator  User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  likes    Like[]
  comments   Comment[]
  savedPosts SavedPost[]

  @@index([creatorId])
  @@index([createdAt])
  @@index([creatorId, createdAt])
  @@index([latitude, longitude])
  @@map("posts")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("likes")
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("comments")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model KycRecord {
  id               String    @id @default(uuid())
  userId           String
  veriffSessionId  String    @unique
  status           KycStatus @default(PENDING)
  veriffDecision   Json?
  veriffPerson     Json?
  createdAt        DateTime  @default(now())
  decidedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("kyc_records")
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@map("saved_posts")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // new_like, new_comment, new_follow, new_post, creator_approval
  title     String
  body      String
  data      Json?    // { postId, creatorId, etc. }
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
  @@map("notifications")
}

enum TokenStatus {
  PENDING
  DEPLOYING
  ACTIVE
  FAILED
  GRADUATED
}

enum PoolType {
  BONDING_CURVE
  RAYDIUM
}

model CreatorToken {
  id                 String      @id @default(uuid())
  userId             String
  chain              String      // "solana" | "base"
  name               String      // Display name, e.g. "Deel Token"
  symbol             String      // Ticker, e.g. "DEEL"
  description        String?
  imageUrl           String?     // Token logo
  mintAddress         String?     @unique // SPL mint (Solana) or ERC-20 contract (Base)
  decimals           Int         @default(9) // 9 for Solana SPL, 18 for ERC-20
  totalSupply        String      @default("1000000000") // String for precision
  circulatingSupply  String      @default("0")
  poolAddress        String?     // AMM pool or bonding curve contract
  poolType           PoolType?
  bondingCurveParams Json?       // { slope, basePrice, reserveRatio, ... }
  status             TokenStatus @default(PENDING)
  deployTxSignature  String?     // On-chain tx hash for deploy
  deployedAt         DateTime?
  graduatedAt        DateTime?   // When token moved from bonding curve to DEX
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  creator User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chain])
  @@index([chain, status])
  @@index([symbol])
  @@map("creator_tokens")
}

model PortfolioSnapshot {
  id              String   @id @default(uuid())
  userId          String
  chain           String   @default("solana")
  totalValueUsd   Float
  nativeBalance   Float
  nativeValueUsd  Float
  tokenValueUsd   Float
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, chain, createdAt])
  @@map("portfolio_snapshots")
}

model WalletTransaction {
  id               String   @id @default(uuid())
  userId           String
  chain            String
  signature        String
  type             String   // "swap" | "send" | "receive" | "fund"
  label            String
  inputToken       String?
  outputToken      String?
  inputAmount      String?
  outputAmount     String?
  recipientAddress String?
  status           String   @default("confirmed")
  createdAt        DateTime @default(now())

  @@unique([userId, chain, signature])
  @@index([userId, chain, createdAt])
  @@map("wallet_transactions")
}

model PromotionLog {
  id        String   @id @default(uuid())
  actorId   String
  targetId  String
  method    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([targetId])
  @@index([actorId])
  @@index([createdAt])
  @@map("promotion_logs")
}
