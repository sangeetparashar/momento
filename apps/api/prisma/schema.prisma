generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  CREATOR
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum PostType {
  TEXT
  IMAGE
  VIDEO
}

model User {
  id              String    @id @default(uuid())
  privyUserId     String    @unique
  walletAddress     String    @unique
  primaryChain      String    @default("solana")
  email             String?
  username        String?   @unique
  displayName     String?
  bio             String?
  avatarUrl       String?
  bannerUrl       String?
  role            UserRole  @default(USER)
  kycStatus       KycStatus @default(NONE)
  isAdminApproved Boolean   @default(false)
  isAdmin         Boolean   @default(false)
  tokenSymbol     String?
  socialLinks     Json?
  locationLat     Float?
  locationLng     Float?
  pushToken       String?
  followerCount   Int       @default(0)
  followingCount  Int       @default(0)
  postCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  posts      Post[]
  likes      Like[]
  comments   Comment[]
  followers  Follow[]    @relation("following")
  following  Follow[]    @relation("follower")
  kycRecords KycRecord[]
  savedPosts SavedPost[]
  creatorTokens CreatorToken[]

  // ── Phase 2 token-economy back-relations ──
  trades                 Trade[]
  fundraiseContributions FundraiseContribution[]
  vestingSchedules       VestingSchedule[]

  @@index([role])
  @@index([locationLat, locationLng])
  @@map("users")
}

model Post {
  id          String   @id @default(uuid())
  creatorId   String
  postType    PostType @default(TEXT)
  content     String?
  caption     String?
  mediaUrl    String?
  mediaUrls   Json?
  latitude    Float
  longitude   Float
  likeCount   Int      @default(0)
  commentCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator  User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  likes    Like[]
  comments   Comment[]
  savedPosts SavedPost[]

  @@index([creatorId])
  @@index([createdAt])
  @@index([creatorId, createdAt])
  @@index([latitude, longitude])
  @@map("posts")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("likes")
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("comments")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model KycRecord {
  id               String    @id @default(uuid())
  userId           String
  veriffSessionId  String    @unique
  status           KycStatus @default(PENDING)
  veriffDecision   Json?
  veriffPerson     Json?
  createdAt        DateTime  @default(now())
  decidedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("kyc_records")
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@map("saved_posts")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // new_like, new_comment, new_follow, new_post, creator_approval
  title     String
  body      String
  data      Json?    // { postId, creatorId, etc. }
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
  @@map("notifications")
}

enum TokenStatus {
  PENDING
  DEPLOYING
  ACTIVE
  FAILED
  GRADUATED
}

enum PoolType {
  BONDING_CURVE
  RAYDIUM
  METEORA_DBC
  METEORA_DAMM_V2
}

enum TokenProgram {
  TOKEN_CLASSIC // legacy classic SPL (Tokenkeg…)
  TOKEN_2022 // Token-2022 (TokenzQd…) — all new launches
}

enum FundraiseStatus {
  DRAFT
  ACTIVE
  THRESHOLD_MET
  FINALIZING
  COMPLETED
  FAILED
  REFUNDED
}

enum FeeSource {
  IN_APP
  EXTERNAL
}

enum TradeSide {
  BUY
  SELL
}

enum FeeEventType {
  TRANSFER_FEE_WITHHELD
  PARTNER_TRADING_FEE
  CREATOR_TRADING_FEE
  LOCKED_LP_FEE
  SURPLUS
  REBATE
  CLAIMED
}

enum FeeRecipient {
  PLATFORM
  CREATOR
  PROTOCOL
  TRADER
}

enum LpProvider {
  METEORA_DAMM_V2
  METEORA_DAMM_V1
  METEORA_DLMM
}

enum LpOwner {
  PARTNER
  CREATOR
}

enum VestingProvider {
  STREAMFLOW
  JUP_LOCK
}

enum VestingStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELED
}

model CreatorToken {
  id                 String      @id @default(uuid())
  userId             String
  chain              String      // "solana" | "base"
  name               String      // Display name, e.g. "Deel Token"
  symbol             String      // Ticker, e.g. "DEEL"
  description        String?
  imageUrl           String?     // Token logo
  mintAddress         String?     @unique // SPL mint (Solana) or ERC-20 contract (Base)
  decimals           Int         @default(9) // 9 for Solana SPL, 18 for ERC-20
  totalSupply        String      @default("1000000000") // String for precision
  circulatingSupply  String      @default("0")
  poolAddress        String?     // AMM pool or bonding curve contract
  poolType           PoolType?
  bondingCurveParams Json?       // { slope, basePrice, reserveRatio, ... }
  status             TokenStatus @default(PENDING)
  deployTxSignature  String?     // On-chain tx hash for deploy
  deployedAt         DateTime?
  graduatedAt        DateTime?   // When token moved from bonding curve to DEX
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // ── Phase 2 token-economy fields ──
  tokenProgram              TokenProgram @default(TOKEN_2022)
  transferFeeBps            Int?
  transferFeeMaxBaseUnits   String?
  transferFeeAuthority      String?
  withdrawWithheldAuthority String?
  quoteMint                 String?
  dbcConfigKey              String?
  dbcPoolAddress            String?

  creator User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Phase 2 token-economy relations ──
  feeConfig     TokenFeeConfig?
  fundraise     TokenFundraise?
  lpPositions   LpPosition[] // plural: partner + creator positions
  trades        Trade[]
  feeEvents     FeeEvent[]
  vestings      VestingSchedule[]
  contributions FundraiseContribution[]

  @@unique([userId, chain])
  @@index([chain, status])
  @@index([symbol])
  @@index([status])
  @@map("creator_tokens")
}

model PortfolioSnapshot {
  id              String   @id @default(uuid())
  userId          String
  chain           String   @default("solana")
  totalValueUsd   Float
  nativeBalance   Float
  nativeValueUsd  Float
  tokenValueUsd   Float
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, chain, createdAt])
  @@map("portfolio_snapshots")
}

model WalletTransaction {
  id               String   @id @default(uuid())
  userId           String
  chain            String
  signature        String
  type             String   // "swap" | "send" | "receive" | "fund"
  label            String
  inputToken       String?
  outputToken      String?
  inputAmount      String?
  outputAmount     String?
  recipientAddress String?
  status           String   @default("confirmed")
  createdAt        DateTime @default(now())

  @@unique([userId, chain, signature])
  @@index([userId, chain, createdAt])
  @@map("wallet_transactions")
}

model PromotionLog {
  id        String   @id @default(uuid())
  actorId   String
  targetId  String
  method    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([targetId])
  @@index([actorId])
  @@index([createdAt])
  @@map("promotion_logs")
}

// =============================================================================
// Phase 2 — Token economy (Solana token-2022, fees, fundraise, LP, vesting)
// See docs/solana-migration/design/phase2/CONTRACTS.md §a.
// =============================================================================

model TokenFeeConfig {
  id      String @id @default(uuid())
  tokenId String @unique

  transferFeeBps  Int // 300–500
  rebateTargetBps Int @default(100) // in-app effective target (~1%)

  creatorTradingFeeBps Int @default(5000) // share of the 80%
  partnerTradingFeeBps Int @default(5000) // share of the 80% (sum = 10000)
  protocolFeeBps       Int @default(2000) // Meteora fixed 20% (recorded, not configurable)

  feeClaimer                String? // Momento partner wallet (DBC feeClaimer)
  creatorFeeWallet          String?
  rebateWallet              String?
  withdrawWithheldAuthority String?
  rebateMint                String? // USDC by default — NEVER the creator token

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  token CreatorToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@map("token_fee_configs")
}

model Trade {
  id           String  @id @default(uuid())
  tokenId      String
  userId       String? // SetNull on user delete
  traderWallet String // on-chain payer

  side   TradeSide
  source FeeSource // IN_APP | EXTERNAL — drives rebate eligibility
  venue  PoolType // METEORA_DBC | METEORA_DAMM_V2 | …

  intentId  String? @unique // set when WE build the tx (IN_APP), pre-signature
  signature String? @unique // ON-CHAIN IDEMPOTENCY KEY (null until confirmed)

  amountInBaseUnits  String
  amountInMint       String
  amountOutBaseUnits String
  amountOutMint      String
  priceUsd           Float? // display only
  priceTs            DateTime? // snapshot time for rebate true-up

  transferFeeBaseUnits String  @default("0")
  feeBps               Int?
  rebateBaseUnits      String  @default("0")
  rebateMint           String?
  rebatePaid           Boolean @default(false)
  rebateSignature      String?

  poolAddress String?
  blockTime   DateTime? // null until confirmed
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  token     CreatorToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  feeEvents FeeEvent[]

  @@index([tokenId, blockTime])
  @@index([userId, blockTime])
  @@index([tokenId, side])
  @@index([traderWallet])
  @@index([source, rebatePaid])
  @@map("trades")
}

model FeeEvent {
  id      String  @id @default(uuid())
  tokenId String
  tradeId String?

  type            FeeEventType
  source          FeeSource
  recipient       FeeRecipient
  recipientWallet String?

  grossBaseUnits String  @default("0")
  feeBaseUnits   String  @default("0")
  netBaseUnits   String  @default("0")
  amountMint     String
  amountUsd      Float?
  feeBps         Int?

  signature      String?   @unique // on-chain rows
  internalRef    String?   @unique // off-chain computed rows: `${tradeId}:${recipient}:${type}`
  claimed        Boolean   @default(false)
  claimedAt      DateTime?
  claimSignature String?

  blockTime DateTime?
  createdAt DateTime  @default(now())

  token CreatorToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  trade Trade?       @relation(fields: [tradeId], references: [id], onDelete: SetNull)

  @@index([tokenId, createdAt])
  @@index([tokenId, type])
  @@index([recipient, claimed])
  @@index([type, createdAt])
  @@index([tradeId])
  @@map("fee_events")
}

model TokenFundraise {
  id      String          @id @default(uuid())
  tokenId String          @unique
  status  FundraiseStatus @default(DRAFT)

  quoteMint                String // USDC by default
  thresholdBaseUnits       String // migration_quote_threshold (USDC base units)
  raisedBaseUnits          String @default("0")
  contributorCount         Int    @default(0)
  minContributionBaseUnits String?
  maxContributionBaseUnits String?

  partnerLpBps       Int?
  creatorLpBps       Int?
  partnerLockedLpBps Int?
  creatorLockedLpBps Int?
  migrationFeeBps    Int?
  leftoverReceiver   String?

  startsAt          DateTime?
  endsAt            DateTime?
  finalizedAt       DateTime?
  finalizeSignature String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  token         CreatorToken            @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  contributions FundraiseContribution[]

  @@index([status])
  @@map("token_fundraises")
}

model FundraiseContribution {
  id            String  @id @default(uuid())
  fundraiseId   String
  tokenId       String // denormalized
  userId        String? // SetNull on user delete
  walletAddress String

  amountBaseUnits String
  quoteMint       String
  signature       String @unique // ON-CHAIN IDEMPOTENCY KEY

  refunded        Boolean   @default(false)
  refundSignature String?   @unique
  blockTime       DateTime?
  createdAt       DateTime  @default(now())

  fundraise TokenFundraise @relation(fields: [fundraiseId], references: [id], onDelete: Cascade)
  token     CreatorToken   @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([fundraiseId, createdAt])
  @@index([tokenId, createdAt])
  @@index([userId])
  @@index([walletAddress])
  @@map("fundraise_contributions")
}

model LpPosition {
  id      String @id @default(uuid())
  tokenId String

  provider    LpProvider @default(METEORA_DAMM_V2)
  owner       LpOwner // PARTNER | CREATOR
  ownerWallet String

  poolAddress     String
  positionAddress String?
  positionNftMint String? @unique
  lpMint          String?

  baseReserveBaseUnits  String?
  quoteReserveBaseUnits String?
  liquidity             String?

  locked          Boolean   @default(true)
  lockedUntil     DateTime?
  createSignature String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  token CreatorToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([tokenId, owner])
  @@index([tokenId])
  @@index([owner])
  @@index([poolAddress])
  @@map("lp_positions")
}

model VestingSchedule {
  id                String  @id @default(uuid())
  tokenId           String
  beneficiaryUserId String? // SetNull on user delete
  beneficiaryWallet String

  provider VestingProvider
  streamId String?         @unique // Streamflow / Jup-Lock PDA

  totalBaseUnits    String
  releasedBaseUnits String @default("0")
  tokenMint         String

  cliffSeconds    Int       @default(0)
  durationSeconds Int
  startAt         DateTime
  cliffAt         DateTime?
  endAt           DateTime?

  status          VestingStatus @default(PENDING)
  createSignature String?       @unique
  cancelSignature String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  token CreatorToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  user  User?        @relation(fields: [beneficiaryUserId], references: [id], onDelete: SetNull)

  @@index([tokenId])
  @@index([beneficiaryUserId])
  @@index([beneficiaryWallet])
  @@index([status])
  @@map("vesting_schedules")
}
