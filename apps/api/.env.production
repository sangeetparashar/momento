# ──────────────────────────────────────────────────────────────────────────────
# Momento API — PRODUCTION
# ──────────────────────────────────────────────────────────────────────────────
# These values should be set via Vercel Environment Variables dashboard,
# NOT committed to git. This file serves as documentation of required vars.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Database (Supabase PostgreSQL) ── REQUIRED ──────────────────────────────
DATABASE_URL=""
DIRECT_URL=""

# ─── Privy Authentication ── REQUIRED ────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# ─── Upstash Redis ── REQUIRED for production ────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Supabase Storage ── REQUIRED ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Helius (Solana RPC) ── REQUIRED ─────────────────────────────────────────
HELIUS_API_KEY=""

# ─── Veriff (KYC) ── REQUIRED ────────────────────────────────────────────────
VERIFF_API_KEY=""
VERIFF_SHARED_SECRET=""

# ─── App Config ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="https://api.momento.network"
# MUST be "false" in production — real KYC required
SKIP_KYC="false"
NODE_ENV="production"
