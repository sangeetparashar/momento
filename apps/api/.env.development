# ──────────────────────────────────────────────────────────────────────────────
# Momento API — LOCAL DEVELOPMENT
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and takes precedence over this file.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Transaction mode (port 6543) — used by Prisma for all queries
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session/Direct mode (port 5432) — used by Prisma for migrations only
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ─── Privy Authentication ────────────────────────────────────────────────────
# Get from: https://dashboard.privy.io > Your App > Settings
# MUST match EXPO_PUBLIC_PRIVY_APP_ID in apps/mobile/.env
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# ─── Upstash Redis (OPTIONAL for dev — caching degrades gracefully) ─────────
# Get from: https://console.upstash.com > Your database > REST API
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Supabase Storage ────────────────────────────────────────────────────────
# Get from: Supabase > Project Settings > API
# This is the PROJECT URL (https://xxxx.supabase.co) — NOT the database URL
NEXT_PUBLIC_SUPABASE_URL=""
# Service role key — full admin access, never expose to frontend
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Helius (Solana RPC) — OPTIONAL for dev ──────────────────────────────────
# Get from: https://dev.helius.xyz > Dashboard > API Keys
HELIUS_API_KEY=""

# ─── Veriff (KYC) — NOT needed when SKIP_KYC=true ───────────────────────────
# Get from: https://station.veriff.com > Integrations > API Keys
VERIFF_API_KEY=""
VERIFF_SHARED_SECRET=""

# ─── App Config ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3000"
# Bypass KYC verification for creator applications (dev only!)
SKIP_KYC="true"
# Node environment
NODE_ENV="development"
